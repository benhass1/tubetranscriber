FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates \
    && python3 -m pip install --no-cache-dir --break-system-packages "youtube-transcript-api>=0.6,<1.0" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN npm install -g corepack@latest && corepack pnpm install && corepack pnpm run build

ENV NODE_ENV=production
ENV PORT=80
CMD ["node", "dist/index.js"]
